# ============================================
# APLICACIÓN
# ============================================
PORT=3000
NODE_ENV=production
# Clave para firmar los JWT. Usar una cadena larga y aleatoria en producción.
SECRET=CambiaEstaClavePorUnaLargaYAleatoria
# URL pública de la API (se usa en los enlaces de los correos)
URL=https://api.tudominio.com

# ============================================
# CORS
# ============================================
# Orígenes permitidos, separados por comas. SOLO se aplica con NODE_ENV=production.
# ATENCIÓN: si se deja vacío en producción, la API acepta CUALQUIER origen.
CORS=true
CORS_ORIGINS=https://web.tudominio.com,https://app.tudominio.com

# ============================================
# LOGGING
# ============================================
LOGGER=true
LOGGER_LEVELS=error,warn,log

# ============================================
# WEBSOCKETS
# ============================================
# Debe ser "true" para que web-saci reciba actualizaciones en tiempo real.
SOCKET_ENABLED=true

# ============================================
# BASE DE DATOS (MongoDB)
# ============================================
TYPE=mongodb
DB_HOST=localhost
DB_PORT=27017
DB_NAME=api-saci
DB_USER=saci_user
DB_PASS=CambiaEstePassword
DB_AUTH_SOURCE=admin
SSL=false
# Solo desarrollo: deja que TypeORM ajuste colecciones e índices.
DB_SYNC=false
# TypeORM no soporta migraciones con MongoDB: se ignora.
DB_MIGRATIONS_RUN=false
MIGRATION_PATH=./src/database/migrations/

# ============================================
# EMAIL (recuperación de contraseña)
# ============================================
EMAIL_SMTP=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_ID=tuemail@gmail.com
EMAIL_PASS=app_password_de_16_caracteres
EMAIL_FROM=noreply@tudominio.com